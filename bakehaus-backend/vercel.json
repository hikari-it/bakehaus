{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "bakehaus-pos.vercel.app"
        }
      ],
      "destination": "/pos.html"
    },
    {
      "source": "/",
      "destination": "/delivery.html"
    }
  ]
}